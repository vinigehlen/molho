{
  "name": "molho",
  "version": "0.1.0",
  "private": true,
  "description": "Molho — plataforma de cardápio digital, PDV e delivery. O ingrediente que transforma.",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:contrast": "pnpm --filter @molho/ui test:contrast",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "pnpm --filter @molho/ui storybook",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.68.0"
  }
}
