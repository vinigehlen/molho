# ══════════════════════════════════════════════════════════════════════════════
# MOLHO — variáveis de ambiente
# ══════════════════════════════════════════════════════════════════════════════
# Copie este arquivo para .env.local e preencha com seus valores reais.
# NUNCA commite o .env.local — ele já está no .gitignore.
# ══════════════════════════════════════════════════════════════════════════════

# ─── DATABASE — Neon ─────────────────────────────────────────────────────────
# DATABASE_URL: app_runtime (só DML, sujeito a RLS) — é o que a API/workers usam.
# DIRECT_URL: app_migrator (dono das tabelas) — é o que `prisma migrate` usa.
# Setup das duas roles + PostGIS: packages/db/README.md e prisma/bootstrap.sql.
DATABASE_URL="postgresql://app_runtime:PASSWORD@ep-xxxxxx.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://app_migrator:PASSWORD@ep-xxxxxx.aws.neon.tech/neondb?sslmode=require"
# Admin bootstrap do Neon (só pra criar/depurar roles — não usar em runtime nem migration).
NEON_ADMIN_URL="postgresql://neondb_owner:PASSWORD@ep-xxxxxx.aws.neon.tech/neondb?sslmode=require"
# Shadow database persistente com PostGIS pré-instalado, só `prisma migrate dev` usa.
# Setup: docs/setup-shadow-database.md.
NEONDB_SHADOW_URL="postgresql://app_migrator:PASSWORD@ep-xxxxxx.aws.neon.tech/neondb_shadow?sslmode=require"

# ─── SEED (dev/staging) ──────────────────────────────────────────────────────
# Sobrescreve o telefone do owner do 1º tenant (hamburgueria-da-vila) por um
# número REAL que você controle — necessário pra login de staff no staging via
# OTP (o dev-login é eliminado do bundle de prod). Ausente = usa o fictício.
# PRÉ-REQUISITO: fazer opt-in DESTE número no sandbox Zenvia ANTES do 1º login,
# senão o SMS não chega. E.164 BR (+55 + DDD + número). O seed RECUSA rodar com
# NODE_ENV=production (nunca sobrescreve contato de lojista real).
MOLHO_SEED_STAFF_PHONE="+5551999990000"
# Idem pro canal de E-MAIL (OTP_CHANNEL_STAFF="email"): e-mail REAL que você
# controle, pra receber o OTP de staff no staging. Ausente = fictício .test
# (CI/dev determinísticos). O owner do seed nasce com telefone E e-mail, então
# é achável nos dois canais.
MOLHO_SEED_STAFF_EMAIL=""
# CSV de e-mails que recebem o papel platform.superadmin (Épico 14).
# `pnpm --filter @molho/db db:seed:superadmin` — idempotente, recusa em produção.
MOLHO_SUPERADMIN_EMAILS=""

# ─── CRIPTOGRAFIA — telefone em repouso (LGPD) ───────────────────────────────
# Mapa versão→chave (32 bytes base64). Ver packages/db/src/crypto/phone.ts.
MOLHO_ENCRYPTION_KEYS='{"1":"troque-por-32-bytes-random-em-base64"}'
# Separada de MOLHO_ENCRYPTION_KEYS de propósito (rotação independente) — HMAC
# do código de OTP e do hash de telefone nos logs. Ver apps/api/src/auth/otp/.
MOLHO_OTP_HMAC_KEY="troque-por-32-bytes-random-em-base64"
# Pepper do email_lookup_hash (identidade de staff por e-mail). SEPARADA das
# outras de propósito e NÃO versionada: o hash É o índice de busca, então
# trocar o pepper exige re-hashear a tabela num job offline — é chave de VIDA
# LONGA. Ausente = a aplicação LANÇA (nunca hash sem pepper).
MOLHO_EMAIL_PEPPER="troque-por-32-bytes-random-em-base64"
# Mapa versão→chave (separada das outras duas). Ver apps/api/src/auth/token/.
MOLHO_JWT_SECRETS='{"1":"troque-por-32-bytes-random-em-base64"}'

# ─── REDIS — Upstash ─────────────────────────────────────────────────────────
REDIS_URL="rediss://default:TOKEN@ENDPOINT.upstash.io:6379"
UPSTASH_REDIS_REST_URL="https://ENDPOINT.upstash.io"
UPSTASH_REDIS_REST_TOKEN="TOKEN"

# ─── STORAGE — Cloudflare R2 (S3-compatible) ─────────────────────────────────
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="molho-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL="https://pub-<hash>.r2.dev"
# Teto de tamanho de foto de produto (bytes) — 5MB. Validado ANTES de gerar a
# presigned URL (o cliente que declarar mais é rejeitado com 400 na hora,
# nunca chega a pedir URL) e assinado como Content-Length exato no PUT (R2
# rejeita corpo de tamanho diferente do assinado). Ver apps/api/src/storage/.
MOLHO_MAX_IMAGE_BYTES="5242880"
# Teto do arquivo de importação de cardápio (CSV/XLSX) — 2MB, dá margem
# confortável pra algumas centenas de linhas. Ver apps/api/src/catalog/import/.
MOLHO_MAX_IMPORT_FILE_BYTES="2097152"

# ─── E-MAIL — Resend ─────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxx"
RESEND_FROM="onboarding@resend.dev"

# ─── APP ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="https://molho.vercel.app"
NEXTAUTH_SECRET="troque-por-um-random-de-32-chars"
# Onde os fronts (storefront, backoffice) acham a API. NEXT_PUBLIC_ porque o
# storefront vai precisar chamar a API do lado do cliente a partir do Épico 7
# (checkout) — nada sensível numa URL base, então prefixar desde já evita
# trocar de variável no meio do caminho. Ver apps/storefront/lib/storefront-api.ts.
NEXT_PUBLIC_API_URL="http://localhost:3333"
# Origens permitidas no CORS COM CREDENCIAIS (Épico 9) — lista separada por
# vírgula, valores EXATOS. Vazio = fronts locais de dev. Produção:
# "https://app.molho.live". Staging: adicione a origem aqui, nunca afrouxe a
# regra (curinga é inválido com credenciais). Ver apps/api/src/bootstrap/cors.ts.
MOLHO_CORS_ORIGINS=""

# ─── MVP MOCKS (trocar em fases futuras) ─────────────────────────────────────
PAYMENT_PROVIDER="mock"
WHATSAPP_MODE="click_to_chat"

# ─── CANAL DO OTP por escopo — "sms" ou "email" (Épico 9c) ──────────────────
# Ausente = "sms" (comportamento histórico). No piloto os dois vão pra "email";
# reativar SMS ao fim é trocar ESTAS envs, não mexer em código. A guarda de
# produção é POR CANAL EM USO: canal selecionado exige provider real (nunca
# mock, que loga o código = bypass de auth); canal não usado não bloqueia o boot.
OTP_CHANNEL_STAFF="sms"
OTP_CHANNEL_CUSTOMER="sms"

# ─── SMS — Zenvia (canal de OTP quando OTP_CHANNEL_* = "sms") ───────────────
# Vazio = MessagingModule usa MockMessagingProvider (não manda SMS de verdade).
ZENVIA_API_KEY=""
# Teto diário de custo — 500 em dev, 5000 em prod (ver CLAUDE.md).
MOLHO_MAX_SMS_PER_DAY="500"

# ─── E-MAIL — Resend (canal de OTP quando OTP_CHANNEL_* = "email") ──────────
# Vazio = MockEmailProvider (não manda e-mail de verdade).
RESEND_API_KEY=""
# Remetente VERIFICADO no Resend. Pré-requisito de DNS (SPF/DKIM/DMARC no
# subdomínio send.molho.live, lead time ~24h) — ver docs/08. Remetente não
# verificado não falha no boot: falha na ENTREGA, que é o modo caro.
MOLHO_EMAIL_FROM="Molho <login@send.molho.live>"

# ─── MAPS — Google Maps Platform (Fase 1) ────────────────────────────────────
GOOGLE_MAPS_API_KEY=""

# ─── OBSERVABILIDADE (opcional no MVP) ───────────────────────────────────────
SENTRY_DSN=""
POSTHOG_KEY=""
