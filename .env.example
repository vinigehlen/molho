# ══════════════════════════════════════════════════════════════════════════════
# MOLHO — variáveis de ambiente
# ══════════════════════════════════════════════════════════════════════════════
# Copie este arquivo para .env.local e preencha com seus valores reais.
# NUNCA commite o .env.local — ele já está no .gitignore.
# ══════════════════════════════════════════════════════════════════════════════

# ─── DATABASE — Neon ─────────────────────────────────────────────────────────
# DATABASE_URL: app_runtime (só DML, sujeito a RLS) — é o que a API/workers usam.
# DIRECT_URL: app_migrator (dono das tabelas) — é o que `prisma migrate` usa.
# Setup das duas roles + PostGIS: packages/db/README.md e prisma/bootstrap.sql.
DATABASE_URL="postgresql://app_runtime:PASSWORD@ep-xxxxxx.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://app_migrator:PASSWORD@ep-xxxxxx.aws.neon.tech/neondb?sslmode=require"
# Admin bootstrap do Neon (só pra criar/depurar roles — não usar em runtime nem migration).
NEON_ADMIN_URL="postgresql://neondb_owner:PASSWORD@ep-xxxxxx.aws.neon.tech/neondb?sslmode=require"
# Shadow database persistente com PostGIS pré-instalado, só `prisma migrate dev` usa.
# Setup: docs/setup-shadow-database.md.
NEONDB_SHADOW_URL="postgresql://app_migrator:PASSWORD@ep-xxxxxx.aws.neon.tech/neondb_shadow?sslmode=require"

# ─── CRIPTOGRAFIA — telefone em repouso (LGPD) ───────────────────────────────
# Mapa versão→chave (32 bytes base64). Ver packages/db/src/crypto/phone.ts.
MOLHO_ENCRYPTION_KEYS='{"1":"troque-por-32-bytes-random-em-base64"}'

# ─── REDIS — Upstash ─────────────────────────────────────────────────────────
REDIS_URL="rediss://default:TOKEN@ENDPOINT.upstash.io:6379"
UPSTASH_REDIS_REST_URL="https://ENDPOINT.upstash.io"
UPSTASH_REDIS_REST_TOKEN="TOKEN"

# ─── STORAGE — Cloudflare R2 (S3-compatible) ─────────────────────────────────
S3_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="molho-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

# ─── E-MAIL — Resend ─────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxx"
RESEND_FROM="onboarding@resend.dev"

# ─── APP ─────────────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="https://molho.vercel.app"
NEXTAUTH_SECRET="troque-por-um-random-de-32-chars"

# ─── MVP MOCKS (trocar em fases futuras) ─────────────────────────────────────
PAYMENT_PROVIDER="mock"
WHATSAPP_MODE="click_to_chat"

# ─── SMS — Zenvia (fallback de OTP, único canal automatizado do MVP) ────────
# Vazio = MessagingModule usa MockMessagingProvider (não manda SMS de verdade).
ZENVIA_API_KEY=""
# Teto diário de custo — 500 em dev, 5000 em prod (ver CLAUDE.md).
MOLHO_MAX_SMS_PER_DAY="500"

# ─── MAPS — Google Maps Platform (Fase 1) ────────────────────────────────────
GOOGLE_MAPS_API_KEY=""

# ─── OBSERVABILIDADE (opcional no MVP) ───────────────────────────────────────
SENTRY_DSN=""
POSTHOG_KEY=""
