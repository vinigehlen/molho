{
  "name": "@molho/db",
  "version": "0.1.0",
  "private": true,
  "description": "Schema Prisma, migrations e client Postgres do Molho (RLS por tenant_id, PostGIS).",
  "type": "commonjs",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run db:generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "DIRECT_URL=postgresql://generate:generate@localhost:5432/generate prisma generate",
    "db:migrate:dev": "dotenv -e ../../.env.local -- prisma migrate dev",
    "db:migrate:deploy": "dotenv -e ../../.env.local -- prisma migrate deploy",
    "db:migrate:status": "dotenv -e ../../.env.local -- prisma migrate status",
    "db:studio": "dotenv -e ../../.env.local -- prisma studio",
    "db:seed": "dotenv -e ../../.env.local -- tsx prisma/seed/index.ts",
    "db:seed:superadmin": "dotenv -e ../../.env.local -- tsx prisma/seed/superadmin.ts"
  },
  "dependencies": {
    "@molho/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.10.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.10.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
