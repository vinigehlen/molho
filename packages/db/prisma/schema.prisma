// Schema Prisma do Molho — fundação (Épico 2).
//
// Escopo deste arquivo: só a fundação multi-tenant (tenants/stores), o
// registry de módulos em tabela (5-B.3) e RBAC (users/user_roles) + auditoria.
// Catálogo, pedidos, pagamentos, endereços/zonas etc. nascem nos épicos deles,
// cada um com sua própria migration — esquema especulativo não entra aqui.
//
// RLS, roles do Postgres, grants e a função app_tenant_visible() NÃO são
// representáveis neste DSL — vivem em SQL puro anexado à migration gerada
// (ver prisma/migrations/*/migration.sql).

generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  // Sem isto, o gerador produz import.meta.url no client mesmo compilado
  // pra CommonJS (tsc não consegue transformar import.meta pra nenhum
  // target) — quebra em runtime pra qualquer consumidor via require()
  // (ex.: apps/api/NestJS). moduleFormat="cjs" evita a sintaxe de vez.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─── Plataforma / módulos (5-B.3) ────────────────────────────────────────────

model Plan {
  id              String   @id
  name            String
  priceMonthCents Int      @map("price_month_cents")
  modules         Json
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenants Tenant[]

  @@map("plans")
}

model FeatureFlag {
  key             String   @id
  rolloutPct      Int      @default(0) @map("rollout_pct")
  tenantAllowlist String[] @default([]) @map("tenant_allowlist") @db.Uuid
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

enum EntitlementSource {
  plan
  addon
  manual
  trial
}

enum EntitlementStatus {
  active
  trialing
  suspended
}

/// Direito ao módulo (super-admin/billing). module_key é TEXT sem FK/enum de
/// propósito — a coerência é garantida pelo teste de sincronização do
/// registry em packages/contracts, não pelo banco.
model TenantEntitlement {
  tenantId    String            @map("tenant_id") @db.Uuid
  moduleKey   String            @map("module_key")
  source      EntitlementSource
  status      EntitlementStatus @default(active)
  trialEndsAt DateTime?         @map("trial_ends_at")
  limits      Json?
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  deletedAt   DateTime?         @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleKey])
  @@map("tenant_entitlements")
}

/// Configuração do lojista (liga/desliga o que já tem direito).
model TenantSetting {
  tenantId  String    @map("tenant_id") @db.Uuid
  moduleKey String    @map("module_key")
  enabled   Boolean   @default(false)
  config    Json?
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleKey])
  @@map("tenant_settings")
}

/// Quem ligou/desligou o quê e quando — trilha do 5-B.5, append-only.
model ModuleAudit {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  moduleKey String   @map("module_key")
  actorId   String   @map("actor_id") @db.Uuid
  action    String
  at        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id])

  @@index([tenantId, at])
  @@map("module_audit")
}

// ─── Tenant / loja ───────────────────────────────────────────────────────────

enum TenantStatus {
  active
  suspended
}

model Tenant {
  id        String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug      String
  name      String
  cnpj      String?
  planId    String?      @map("plan_id")
  status    TenantStatus @default(active)
  themeKey  String       @default("roxo") @map("theme_key")
  timezone  String       @default("America/Sao_Paulo")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  plan                 Plan?                @relation(fields: [planId], references: [id])
  stores               Store[]
  customers            Customer[]
  entitlements         TenantEntitlement[]
  settings             TenantSetting[]
  moduleAudits         ModuleAudit[]
  auditLogs            AuditLog[]
  categories           Category[]
  products             Product[]
  productImages        ProductImage[]
  modifierGroups       ModifierGroup[]
  productModifierGroups ProductModifierGroup[]
  modifiers            Modifier[]
  addresses            Address[]
  deliveryZones        DeliveryZone[]
  storeHours           StoreHours[]
  storeSchedulingSlots StoreSchedulingSlot[]
  orders               Order[]
  orderItems           OrderItem[]
  orderItemModifiers   OrderItemModifier[]
  orderStatusHistories OrderStatusHistory[]
  orderAdjustments     OrderAdjustment[]
  printJobs            PrintJob[]
  coupons              Coupon[]

  // slug é único só entre tenants vivos — índice parcial WHERE deleted_at IS
  // NULL criado à mão na migration (Prisma não expressa índice parcial).
  @@map("tenants")
}

/// Tipo da chave PIX cadastrada pelo lojista — só pra validar formato no
/// cadastro; o payload EMV (Épico 8) usa sempre o VALOR da chave, o tipo não
/// entra no BR Code em si.
enum PixKeyType {
  cpf
  cnpj
  email
  phone
  random
}

model Store {
  id             String                                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String                                 @map("tenant_id") @db.Uuid
  name           String
  addressText    String                                 @map("address_text")
  /// geography(Point,4326) — PostGIS habilitado agora; sem uso ainda (zonas
  /// de entrega chegam no Épico 6, mas o tipo geo já nasce certo).
  geo            Unsupported("geography(Point, 4326)")?
  timezone       String
  phone          String?
  whatsappNumber String?                                @map("whatsapp_number")
  minOrderCents  Int                                    @default(0) @map("min_order_cents")
  /// Chave PIX do LOJISTA (Épico 8) — o dinheiro cai direto na conta dele,
  /// nunca passa pelo Molho (docs/01 §5-D.1, modelo A). Nula até o lojista
  /// configurar; sem ela o checkout não tem como montar o QR e a loja não
  /// está pronta pra vender (mesmo erro de "loja não configurada" da falta
  /// de Store em si — CheckoutStoreNotConfiguredError).
  pixKey          String?     @map("pix_key")
  pixKeyType      PixKeyType? @map("pix_key_type")
  /// Campo 60 do BR Code (cidade do lojista) — curto e sem acento por
  /// exigência do padrão EMV (≤15 chars), por isso não deriva de
  /// `addressText` (texto livre, formato não previsível). Preenchido junto
  /// com a chave PIX.
  pixMerchantCity String?     @map("pix_merchant_city")
  createdAt      DateTime                               @default(now()) @map("created_at")
  updatedAt      DateTime                               @updatedAt @map("updated_at")
  deletedAt      DateTime?                              @map("deleted_at")

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveryZones        DeliveryZone[]
  storeHours           StoreHours[]
  storeSchedulingSlots StoreSchedulingSlot[]
  orders               Order[]

  // Alvo de FK composta (delivery_zones.store_id, store_hours.store_id) —
  // índice único (id, tenant_id) à mão na migration (Épico 6).
  @@index([tenantId])
  @@map("stores")
}

// ─── Cliente final (5-C.4) ───────────────────────────────────────────────────
//
// Duas semânticas de identidade, nunca misturadas (CLAUDE.md): Staff (users,
// abaixo — global, usa user_roles/can()) e Customer (aqui — escopo por
// tenant_id, RLS normal, SEM user_roles/can()). O mesmo telefone em dois
// tenants é dois registros isolados de propósito (pontos de fidelidade não
// cruzam) — por isso Customer tem único parcial em (tenant_id,
// phone_lookup_hash), não um único global como o de User.
//
// Épico 3 cria só o mínimo pra identidade OTP. Endereços, pontos e histórico
// entram nos épicos que os usam (4+).

model Customer {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  name            String
  /// Mesmo padrão de users: cifra na aplicação, nunca em claro (LGPD).
  ///
  /// NULLABLE (Épico balcão): pedido de balcão cria um Customer anônimo,
  /// sem telefone algum — não é "guest do checkout" (que sempre tem telefone
  /// auto-declarado, Épico 9c), é venda no caixa sem coleta de contato. `null`
  /// nunca vira seletor de busca (mesma regra de `users.phoneLookupHash` —
  /// CLAUDE.md § Convenções de schema): todo `findFirst`/`findMany` por
  /// telefone usa `hashPhoneForLookup()`, nunca lê a coluna de volta pra
  /// filtrar. `phoneLookupHash` NULL não colide no índice único parcial
  /// (`customers_active_phone_hash`) — Postgres nunca considera dois NULL
  /// iguais, então N clientes de balcão convivem sem conflito.
  phoneCiphertext Bytes?    @map("phone_ciphertext")
  /// Único só entre linhas vivas E só dentro do tenant — índice parcial
  /// composto criado à mão na migration (Prisma não expressa índice parcial).
  phoneLookupHash String?   @map("phone_lookup_hash")
  phoneKeyVersion Int       @default(1) @map("phone_key_version")
  /// E-mail cifrado — APENAS canal de entrega do OTP durante o piloto (custo
  /// de SMS). A identidade do cliente CONTINUA sendo o telefone: de propósito
  /// NÃO existe email_lookup_hash, nem unique, nem índice por e-mail aqui —
  /// sem índice, nenhum findFirst futuro consegue chavear cliente por e-mail
  /// nem por acidente, e voltar pro SMS é trocar env, não re-migrar.
  emailCiphertext Bytes?    @map("email_ciphertext")
  emailKeyVersion Int       @default(1) @map("email_key_version")
  /// Quando o telefone foi PROVADO por OTP. `null` = auto-declarado (nasceu
  /// pelo checkout guest, Épico 9c) — sem isso, "esse telefone é real?" vira
  /// pergunta sem resposta no banco quando o SMS voltar. Só o verify do OTP
  /// carimba; o guest nunca. Carimba também um registro que JÁ existia como
  /// guest e depois verificou — é upgrade de procedência, não identidade nova.
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  /// Corta sessões na hora, mesmo mecanismo de users.token_version.
  tokenVersion    Int       @default(0) @map("token_version")
  version         Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses            Address[]
  orders               Order[]
  orderStatusHistories OrderStatusHistory[]

  // Alvo de FK composta (addresses.customer_id) — índice único (id,
  // tenant_id) à mão na migration (Épico 6). Fica VAZIA neste épico —
  // CLAUDE.md regra 13: endereço é anônimo até o checkout (Épico 7).
  @@index([tenantId])
  @@map("customers")
}

// ─── Identidade / RBAC (5-C) ─────────────────────────────────────────────────
//
// users e user_roles NÃO têm tenant_id de propósito (platform_support e
// franchisor atuam em vários tenants; o mesmo login não pode ser "dono" de
// um único tenant). Por isso NÃO ganham RLS — é a exceção deliberada e
// documentada em CLAUDE.md: toda query em user_roles exige escopo explícito
// no WHERE, nunca lê a tabela inteira.

enum ScopeType {
  platform
  franchise
  tenant
  store
}

model User {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name            String
  /// Telefone cifrado na aplicação (AES-256-GCM), nunca em claro — LGPD.
  /// NULLABLE desde o passo 3 do OTP por e-mail: staff que nasce pelo canal
  /// de e-mail não tem telefone nenhum.
  phoneCiphertext Bytes?    @map("phone_ciphertext")
  /// HMAC determinístico do telefone — é o que o login por OTP SMS busca.
  /// Único só entre linhas vivas — índice único parcial criado à mão na
  /// migration (Prisma não expressa índice parcial no DSL).
  ///
  /// NULLABLE: como SELETOR, o valor SEMPRE vem de `hashPhoneForLookup()`,
  /// nunca de um `string | null` lido do banco — `where: { phoneLookupHash:
  /// null }` não acha "nada", acha TODO staff sem telefone (foi assim que um
  /// `deleteMany` de teste quase apagou todos os staff de e-mail). Filtrar
  /// "sem telefone" exige `null` LITERAL, com intenção. Ver CLAUDE.md
  /// § "Convenções de schema" → seletor por `*_lookup_hash`.
  phoneLookupHash String?   @map("phone_lookup_hash")
  /// Versão da chave de cifra usada (rotação lazy, sem migration em massa).
  phoneKeyVersion Int       @default(1) @map("phone_key_version")
  /// E-mail cifrado (AES-256-GCM) — mesma política do telefone, nunca em
  /// claro. A coluna `email` em TEXTO que existia aqui foi dropada: nunca
  /// recebeu um byte, e em claro ao lado do hash anularia o pepper.
  emailCiphertext Bytes?    @map("email_ciphertext")
  /// HMAC(e-mail normalizado, MOLHO_EMAIL_PEPPER) — é o que o login de staff
  /// por OTP de e-mail busca, e a CHAVE DE IDENTIDADE de staff no piloto.
  /// Único só entre linhas vivas — índice único parcial à mão na migration.
  ///
  /// NULLABLE: mesma regra de seletor do `phoneLookupHash` acima — o valor
  /// vem sempre de `hashEmailForLookup()`, nunca de leitura do banco, e
  /// `null` como filtro casa com todo staff SEM e-mail.
  emailLookupHash String?   @map("email_lookup_hash")
  emailKeyVersion Int       @default(1) @map("email_key_version")
  /// Corta sessões na hora (demitir um garçom = incrementar e revogar).
  tokenVersion    Int       @default(0) @map("token_version")
  version         Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  /// Desligar/demitir é reversível — preserva histórico em user_roles/audit_log.
  deletedAt       DateTime? @map("deleted_at")

  roles                UserRole[]
  moduleAudits         ModuleAudit[]
  auditLogs            AuditLog[]
  orderStatusHistories OrderStatusHistory[]
  orderAdjustments     OrderAdjustment[]

  @@map("users")
}

/// Uma atribuição papel+escopo. platform tem scopeId null.
model UserRole {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// Validado contra ROLES em packages/contracts/permissions.ts na aplicação.
  role      String
  scopeType ScopeType @map("scope_type")
  scopeId   String?   @map("scope_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, scopeType, scopeId])
  @@map("user_roles")
}

// ─── Catálogo (Épico 4) ───────────────────────────────────────────────────────
//
// Tenant-scoped, SEM store_id: docs/01-plano-produto.md §5.1 modela o
// cardápio por tenant (um cardápio por loja só chega com o módulo
// multi_store, Fase 3/Premium — não é retrofit desta tabela, é override
// futuro). Sem combos de propósito (Fase 2, já travado por teste em
// packages/contracts/src/permissions.test.ts).
//
// modifier_groups e modifiers carregam tenant_id denormalizado (não só o FK
// pro pai) porque a policy de RLS lê a coluna da PRÓPRIA linha — não
// atravessa join. E toda FK que liga uma linha tenant-scoped a outra é
// COMPOSTA (filho_id, tenant_id) → (pai.id, pai.tenant_id), nunca FK simples:
// isso é o que impede fisicamente um modifier_group com tenant_id=A apontar
// pra um product de tenant_id=B — nível de banco, sem trigger. Exige um
// índice único (id, tenant_id) no pai só pra servir de alvo da FK composta
// do filho (Postgres exige unique/PK na coluna referenciada).

model Category {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  visible   Boolean   @default(true)
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId, sortOrder])
  @@map("categories")
}

model Product {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  categoryId     String    @map("category_id") @db.Uuid
  name           String
  description    String?
  /// Sempre inteiro em centavos, nunca float (CLAUDE.md regra 4). CHECK >= 0
  /// à mão na migration (Prisma não expressa CHECK no DSL).
  basePriceCents Int       @map("base_price_cents")
  /// Chave do objeto no R2 — nasce nula, preenchida pelo upload (commit 6).
  /// Épico conversão (C1): vira DERIVADO da foto de `position=0` em
  /// `ProductImage` assim que o produto tiver pelo menos uma linha lá — a
  /// coluna em si continua existindo (compat de quem ainda lê `imageKey`
  /// direto), mas o storefront/admin escrevem em `ProductImage`, não aqui.
  imageKey       String?   @map("image_key")
  /// "Esgotado manual" (§5.4 definicoes-v1) — toggle direto, sem contador.
  available      Boolean   @default(true)
  /// Código do item no PDV do lojista (Épico combos/PDV, exceção MVP
  /// 2026-08-28) — texto livre, opcional, nunca validado/interpretado por
  /// nós: é só o número/código que o sistema de caixa do lojista já usa,
  /// pra ele bater cardápio digital × PDV sem digitar duas vezes.
  pdvCode        String?   @map("pdv_code")
  sortOrder      Int       @default(0) @map("sort_order")
  version        Int       @default(0)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id])
  /// Grupo "dono" (criado a partir DESTE produto) — FK direta, ainda usada
  /// pra decidir onde um grupo novo nasce. Pra "quais grupos valem PRA este
  /// produto" (inclui reuso), ver `productModifierGroups` — fase reuso
  /// (exceção MVP 2026-08-28, CLAUDE.md).
  modifierGroups ModifierGroup[]
  productModifierGroups ProductModifierGroup[]
  orderItems     OrderItem[]
  images         ProductImage[]

  // FK composta (category_id, tenant_id) → categories(id, tenant_id) vive na
  // migration SQL — Prisma não expressa FK composta parcial no DSL a partir
  // de uma relação simples; ver migration.
  @@index([tenantId, categoryId, sortOrder])
  @@map("products")
}

/// N fotos por produto (Épico conversão, C1) — tabela em vez de array de URL
/// no Product pra ordenar (`position`) sem inflar a row do produto. `position
/// = 0` é a CAPA: é o que `Product.imageKey`/`storefrontProductSchema.imageUrl`
/// expõem pra quem ainda lê a foto única (compat), até o storefront consumir
/// a galeria inteira.
model ProductImage {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  /// Chave do objeto no R2 — mesmo fluxo de upload presignado do Product.imageKey.
  imageKey  String    @map("image_key")
  /// 0 = capa. Reordenar é um PATCH por linha (mesmo padrão de sort_order em
  /// Category/Product — não existe endpoint de reorder em lote no catálogo).
  position  Int       @default(0)
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  // FK composta (product_id, tenant_id) → products(id, tenant_id) na migration.
  @@index([tenantId, productId, position])
  @@map("product_images")
}

model ModifierGroup {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  productId String    @map("product_id") @db.Uuid
  name      String
  /// CHECK min >= 0 AND min <= max à mão na migration.
  min       Int       @default(0)
  max       Int       @default(1)
  /// Pausar SEM apagar (Épico combos/PDV) — mesma ideia do produto
  /// "esgotado": o grupo continua existindo (histórico de pedido não
  /// quebra), só não aparece pro cliente escolher.
  active    Boolean   @default(true)
  pdvCode   String?   @map("pdv_code")
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product               Product                @relation(fields: [productId], references: [id])
  modifiers             Modifier[]
  productModifierGroups ProductModifierGroup[]

  // FK composta (product_id, tenant_id) → products(id, tenant_id) na migration.
  @@index([tenantId, productId])
  @@map("modifier_groups")
}

/// Reuso de grupo de complemento entre produtos (exceção MVP 2026-08-28,
/// CLAUDE.md — fase 2/4 do combo). `ModifierGroup.productId` continua
/// sendo o dono/criador (onde o grupo nasceu); esta tabela é a lista real
/// de "em quais produtos este grupo vale" — todo grupo, inclusive os
/// antigos, tem pelo menos UMA linha aqui (a migration faz o backfill do
/// productId original). "Quais grupos valem pra este produto" SEMPRE
/// consulta esta tabela, nunca `ModifierGroup.productId` direto — depois
/// do backfill, os dois caminhos concordam pro caso 1:1 de sempre, e só
/// esta tabela sabe sobre vínculo extra.
model ProductModifierGroup {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  modifierGroupId String    @map("modifier_group_id") @db.Uuid
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id])

  // FKs compostas (product_id, tenant_id) → products(id, tenant_id) e
  // (modifier_group_id, tenant_id) → modifier_groups(id, tenant_id) na
  // migration. Único parcial (product_id, modifier_group_id) WHERE
  // deleted_at IS NULL também na migration (convenção soft-delete).
  @@index([tenantId, productId])
  @@index([tenantId, modifierGroupId])
  @@map("product_modifier_groups")
}

model Modifier {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  groupId         String    @map("group_id") @db.Uuid
  name            String
  /// Sempre >= 0 (CHECK na migration) — complemento nunca reduz o preço base.
  priceDeltaCents Int       @map("price_delta_cents")
  version         Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  group              ModifierGroup       @relation(fields: [groupId], references: [id])
  orderItemModifiers OrderItemModifier[]

  // FK composta (group_id, tenant_id) → modifier_groups(id, tenant_id) na migration.
  @@index([tenantId, groupId])
  @@map("modifiers")
}

// ─── Endereços, zonas de entrega e horários (Épico 6) ────────────────────────

/// Endereço do cliente. Tenant-scoped (mesma regra de customers: mesmo
/// telefone em duas lojas = registros isolados, endereço não cruza).
///
/// CLAUDE.md regra 13: esta tabela nasce AGORA com o schema completo — o
/// Épico 7 vai precisar dela e a decisão de shape pertence a quem cria a
/// tabela — mas fica VAZIA até lá. Durante a navegação (Épico 6), o
/// endereço em uso é um objeto no localStorage (packages/contracts, mesmo
/// tratamento do Cart), nunca uma linha aqui. Só depois do OTP no checkout
/// (Épico 7) o endereço vira linha, vinculada ao customer autenticado.
model Address {
  id             String                                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String                                @map("tenant_id") @db.Uuid
  customerId     String                                @map("customer_id") @db.Uuid
  /// String livre, não enum — mesmo racional do Store.themeKey: o cliente
  /// sugere "Casa"/"Trabalho", mas nunca trava num valor desconhecido.
  label          String                                @default("Endereço")
  street         String
  /// Aceita "s/n" como valor — endereço sem número não é dado ausente.
  number         String?
  complement     String?
  neighborhood   String
  city           String
  state          String
  postalCode     String?                               @map("postal_code")
  /// "Perto da padaria" — padrão BR, útil pro motoboy. Livre, sem estrutura.
  referencePoint String?                               @map("reference_point")
  /// geography(Point,4326) — mesmo tipo do Store.geo. NULLABLE desde o Bloco
  /// 2 do Épico 6: com taxa por município, o preço vem da CIDADE e o ponto
  /// não participa do cálculo — serve pro motoboy/mapa. Geocoder mudo (OSM
  /// fora do ar) não pode recusar endereço válido. Sem fallback pro geo da
  /// loja: pin falso é pior que pin ausente.
  geo            Unsupported("geography(Point, 4326)")?
  version        Int                                   @default(0)
  createdAt      DateTime                              @default(now()) @map("created_at")
  updatedAt      DateTime                              @updatedAt @map("updated_at")
  deletedAt      DateTime?                             @map("deleted_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  orders   Order[]

  // FK composta (customer_id, tenant_id) → customers(id, tenant_id) vive na
  // migration SQL. Índice único (id, tenant_id) também à mão — alvo futuro
  // de orders.delivery_address_id (Épico 7).
  @@index([tenantId, customerId])
  @@map("addresses")
}

/// Zona de entrega da loja — polígono PostGIS, taxa fixa e ETA min/max.
/// N zonas por loja (mesmo com 1 só no seed): "taxa e ETA POR zona" já pede
/// suporte a múltiplas, e zona premium sobreposta a uma maior é caso real.
model DeliveryZone {
  id            String                                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String                                  @map("tenant_id") @db.Uuid
  storeId       String                                  @map("store_id") @db.Uuid
  /// Identificação pro lojista (ex. "Zona padrão") — sem uso no match.
  name          String
  /// Zona por CIDADE (Épico 6, pivot): município servido, taxa fixa. Casa por
  /// `molho_city_key(city)` (minúsculo, sem acento, sem espaço nas pontas) +
  /// `upper(btrim(state))`. XOR com `polygon` — CHECK
  /// `delivery_zones_city_xor_polygon` na migration.
  city          String?
  /// UF. TEXT livre de propósito: validação de sigla pertence ao form do
  /// backoffice e ao ViaCEP, não a um CHECK no banco.
  state         String?
  /// geography(Polygon,4326) — zona por RAIO, via ST_Buffer a partir do
  /// Store.geo. NULLABLE desde o pivot pra cidade: uma zona tem city XOR
  /// polygon. Caminho vivo, não legado — tenant que cobra por distância usa
  /// este.
  polygon       Unsupported("geography(Polygon, 4326)")?
  feeCents      Int                                     @map("fee_cents")
  etaMinMinutes Int                                     @map("eta_min_minutes")
  etaMaxMinutes Int                                     @map("eta_max_minutes")
  /// Zonas sobrepostas: menor valor é checado primeiro (zona premium menor
  /// "vence" a zona grande por fora). CHECK >= 0 na migration.
  priority      Int                                     @default(0)
  version       Int                                     @default(0)
  createdAt     DateTime                                @default(now()) @map("created_at")
  updatedAt     DateTime                                @updatedAt @map("updated_at")
  deletedAt     DateTime?                               @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id])

  // FK composta (store_id, tenant_id) → stores(id, tenant_id) na migration.
  // Índice GiST em `polygon` (obrigatório pra ST_Contains, Prisma não
  // expressa) também à mão — ver migration SQL. Único parcial de
  // (tenant, store, cidade, UF) idem: expressão de função, o DSL não
  // expressa.
  @@index([tenantId, storeId])
  @@map("delivery_zones")
}

enum DayOfWeek {
  sunday
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
}

/// Turno de funcionamento. N turnos por dia (a Vila tem 2: almoço e
/// jantar) — ausência de linha pro dia inteiro é o "fechado" (segunda da
/// Vila não tem nenhuma linha, não uma linha com flag desligada).
model StoreHours {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  storeId         String    @map("store_id") @db.Uuid
  /// Dia em que o turno COMEÇA.
  dayOfWeek       DayOfWeek @map("day_of_week")
  /// Minutos desde meia-noite (0–1439) — não `TIME`, pra virada de dia ser
  /// aritmética simples (comparação de inteiro), não fuso.
  opensAtMinutes  Int       @map("opens_at_minutes")
  /// `closesAtMinutes < opensAtMinutes` SIGNIFICA "fecha no dia seguinte" —
  /// ex. bar sexta 22h–sábado 02h: dayOfWeek=friday, opens=1320, closes=120.
  /// Sem coluna booleana extra pra isso; a semântica é a comparação em si.
  closesAtMinutes Int       @map("closes_at_minutes")
  version         Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id])

  // FK composta (store_id, tenant_id) → stores(id, tenant_id) na migration.
  // Índice começa por tenant_id (CLAUDE.md) e já cobre a query de "aberto
  // agora" (tenant_id + store_id + day_of_week).
  @@index([tenantId, storeId, dayOfWeek])
  @@map("store_hours")
}

/// Slot agendável (Épico conversão, C3) — camada EM CIMA de StoreHours, não
/// substituta: "quando a loja abre" (StoreHours) e "quais janelas dentro
/// disso aceitam pedido AGENDADO, com teto de quantos" (aqui) são perguntas
/// diferentes. Recorrente por dia da semana (mesmo padrão de StoreHours),
/// não por data — o teto (`maxOrders`) é por OCORRÊNCIA do slot (uma
/// sexta-feira específica), nunca somado entre semanas; quem conta os
/// pedidos já agendados numa ocorrência é o serviço de checkout (fora do
/// escopo deste commit — ver docs/handoff-features-conversao-gestor.md A3).
model StoreSchedulingSlot {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  storeId         String    @map("store_id") @db.Uuid
  dayOfWeek       DayOfWeek @map("day_of_week")
  /// Minutos desde meia-noite (0–1439) — mesmo racional de StoreHours.
  startsAtMinutes Int       @map("starts_at_minutes")
  endsAtMinutes   Int       @map("ends_at_minutes")
  /// Teto de pedidos agendados NESTA ocorrência do slot (CHECK > 0 na migration).
  maxOrders Int @map("max_orders")
  version   Int @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id])

  // FK composta (store_id, tenant_id) → stores(id, tenant_id) na migration.
  @@index([tenantId, storeId, dayOfWeek])
  @@map("store_scheduling_slots")
}

// ─── Pedidos (Épico 7) ────────────────────────────────────────────────────────
//
// DÉBITO ADIADO (registrar no CLAUDE.md ao fechar o épico): retirada no
// balcão ("pickup") não é um tipo de pedido de verdade neste épico — a
// cópia `foraDaArea` (Épico 6) já sinaliza a alternativa, mas é só
// informativa (cliente contata o restaurante por fora). `order_type`
// (delivery/pickup) com delivery_* nullable condicionado a ele é migration
// futura, não hoje — todo pedido criado neste épico é de entrega.

enum OrderStatus {
  pending_payment
  received
  preparing
  ready
  in_transit
  completed
  expired
  auto_canceled
  canceled
  delivery_failed
}

enum PaymentStatus {
  aguardando_confirmacao
  confirmado
}

/// Granular de propósito (cash ≠ card) — docs/02-definicoes-v1.md §5.5:
/// dinheiro e cartão na maquininha são operações diferentes na ponta
/// (troco vs nada) pro Épico 9, mesmo os dois dependendo do mesmo módulo
/// `payments.on_delivery`.
///
/// `cash_at_counter`/`card_at_counter` (Épico balcão): pedido de RETIRADA
/// pago na hora, no balcão — mesma distinção dinheiro×cartão dos dois
/// acima, mas fulfillment `pickup`, não `delivery`. PIX de balcão REUSA o
/// valor `pix` (é o mesmo QR/confirmação manual, só muda onde o cliente
/// está parado) — não precisa de um 4º valor.
enum PaymentMethod {
  pix
  cash_on_delivery
  card_on_delivery
  cash_at_counter
  card_at_counter
}

/// Estorno é MANUAL no MVP (PIX estático — o lojista devolve por fora,
/// Pix Devolução). Este campo só REGISTRA que um estorno é devido/foi
/// feito; o sistema nunca orquestra o dinheiro em si.
enum RefundStatus {
  not_applicable
  pending
  completed
}

/// Docs/03 §4 e docs/04 §"Checkout" já previam os dois; só nascia MVP
/// delivery-only. `pickup` = retirada no balcão — o cliente busca no
/// endereço da PRÓPRIA loja (`Store.addressText`, já existe), então nenhum
/// campo novo de loja é necessário, só a ausência do endereço do cliente.
enum FulfillmentType {
  delivery
  pickup
}

model Order {
  id         String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  /// Não assume "1 loja por tenant" como outros épicos — Premium permite
  /// multi-loja (docs/02 §4), e backfill de pedido antigo seria migration dolorosa.
  storeId    String @map("store_id") @db.Uuid
  /// Nunca nulo: pedido só nasce depois do OTP (CLAUDE.md regra 13).
  customerId String @map("customer_id") @db.Uuid

  status        OrderStatus   @default(received)
  /// Sem @default — o cliente escolhe no checkout, nunca "cai" num método sem querer.
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(aguardando_confirmacao) @map("payment_status")
  refundStatus  RefundStatus  @default(not_applicable) @map("refund_status")
  /// `pickup` = os campos `delivery*` abaixo (exceto `deliveryPostalCodeVerified`,
  /// irrelevante nesse branch) ficam NULL — CHECK na migration garante que
  /// `delivery` só nasce sem eles. Sem @default: o cliente escolhe no
  /// carrinho, nunca "cai" num tipo sem querer (mesmo racional de paymentMethod).
  fulfillmentType FulfillmentType @map("fulfillment_type")
  /// Só quando paymentMethod = cash_on_delivery — "troco pra quanto" (o valor
  /// que o cliente vai entregar, não o troco em si). docs/02 §5.5.
  changeForCents Int? @map("change_for_cents")
  /// Agendamento (Épico conversão, C3). `null` = "o quanto antes" — o
  /// comportamento ATUAL, preservado por default. Setado = cliente escolheu
  /// data/horário no checkout; validar contra StoreSchedulingSlot (horário +
  /// teto) é trabalho do serviço de checkout, fora do escopo deste commit.
  scheduledFor DateTime? @map("scheduled_for")

  subtotalCents    Int @map("subtotal_cents")
  deliveryFeeCents Int @map("delivery_fee_cents")
  /// SEMPRE "quanto foi cobrado" no momento da criação — NUNCA "quanto o
  /// cliente pagou líquido de estorno". Estorno (parcial ou integral) é
  /// registrado em `refundStatus` e no `audit_log`/`order_status_history`,
  /// não recalculado aqui. CHECK `= subtotal + fee` na migration —
  /// intencional pra este épico (MVP, estorno manual fora do sistema); se o
  /// Épico 8 (PIX online, estorno automático) precisar de um "total líquido"
  /// de verdade, isso é um campo NOVO, não uma mudança de semântica deste.
  totalCents       Int @map("total_cents")

  /// Cupom de desconto (Épico conversão, C2). Sempre 0 até o checkout aplicar
  /// um cupom — CHECK na migration garante `discount_cents > 0 ⟺ coupon_id
  /// preenchido`, nunca desconto "solto" sem cupom (v1 não tem desconto
  /// manual). NÃO é o mesmo conceito do aviso em `totalCents` acima (esse é
  /// sobre ESTORNO pós-criação; desconto muda quanto foi cobrado NA CRIAÇÃO,
  /// então entra na mesma fórmula do CHECK de total, não é campo novo de
  /// "total líquido").
  discountCents Int @default(0) @map("discount_cents")
  /// FK só rastreabilidade (mesmo racional de deliveryAddressId) — o pedido
  /// nunca depende do cupom continuar existindo/ativo. `couponCodeSnapshot`
  /// é a fonte de verdade pra EXIBIR o código no pedido depois.
  couponId           String? @map("coupon_id") @db.Uuid
  couponCodeSnapshot String? @map("coupon_code_snapshot")

  /// Total ATUAL do pedido, depois de ajustes do balcão (Épico balcão —
  /// edição de pedido). `NULL` = pedido nunca sofreu ajuste, `subtotalCents`/
  /// `totalCents` acima (congelados na criação) continuam valendo como
  /// "o total" — quem lê usa fallback (`currentTotalCents ?? totalCents`),
  /// nunca reescreve os campos originais. Uma vez setado, é
  /// `subtotalCents original + Σ deltas de order_adjustments` — cada
  /// ajuste RECALCULA a partir da soma, nunca aplica delta em cima do
  /// valor atual anterior sem recontar (evita drift acumulado por bug de
  /// arredondamento). CHECK `currentTotal = currentSubtotal + deliveryFee`
  /// e "os dois nulos ou os dois setados" na migration (SQL à mão — mesma
  /// convenção do CHECK de delivery).
  currentSubtotalCents Int? @map("current_subtotal_cents")
  currentTotalCents    Int? @map("current_total_cents")

  /// FK só rastreabilidade — o pedido NUNCA depende da linha em `addresses`
  /// continuar existindo. Snapshot completo abaixo é a fonte de verdade
  /// pra ESTE pedido, pro cliente poder editar o endereço salvo depois sem
  /// alterar pedidos já feitos (mesmo princípio do carrinho).
  ///
  /// Nullable (Épico "retirada"): só existem quando `fulfillmentType ==
  /// delivery` — pickup não coleta endereço do cliente nenhum (retira no
  /// endereço da PRÓPRIA loja, que o lojista já sabe de cor). CHECK na
  /// migration barra a combinação inválida (`delivery` sem endereço).
  deliveryAddressId      String?                               @map("delivery_address_id") @db.Uuid
  deliveryLabel          String?                               @map("delivery_label")
  deliveryStreet         String?                               @map("delivery_street")
  deliveryNumber         String?                               @map("delivery_number")
  deliveryComplement     String?                               @map("delivery_complement")
  deliveryNeighborhood   String?                               @map("delivery_neighborhood")
  deliveryCity           String?                               @map("delivery_city")
  deliveryState          String?                               @map("delivery_state")
  deliveryPostalCode     String?                               @map("delivery_postal_code")
  deliveryReferencePoint String?                               @map("delivery_reference_point")
  /// geography(Point,4326) NULLABLE — mesmo racional de Address.geo (Épico
  /// 6, Bloco 2): a zona por município decide a taxa sem ponto nenhum.
  deliveryGeo            Unsupported("geography(Point, 4326)")? @map("delivery_geo")
  /// Falso quando o ViaCEP ficou mudo e a CIDADE que decidiu a taxa veio do
  /// texto digitado pelo cliente, não de fonte autoritativa — o gestor mostra
  /// pro lojista conferir a taxa antes de despachar.
  deliveryPostalCodeVerified Boolean                           @default(true) @map("delivery_postal_code_verified")
  /// Snapshot da procedência da IDENTIDADE no momento do pedido (Épico 9c):
  /// `false` = nasceu pelo checkout guest (`checkout.guest`), com telefone
  /// auto-declarado e sem OTP. Snapshot, e não JOIN em
  /// `customers.phone_verified_at`, porque aquele campo é mutável (o cliente
  /// pode verificar depois) e reescreveria a história — a decisão "confio
  /// nesse pedido" acontece na hora do pedido. SEM `@default` de propósito:
  /// quem insere é SQL cru que lista a coluna, e um default `true` deixaria
  /// um writer futuro carimbar "verificado" por omissão.
  customerVerified           Boolean                           @map("customer_verified")

  /// Prazo máximo prometido no momento da criação. Congelado: delivery usa
  /// o etaMaxMinutes da zona; pickup usa 30 min. Nullable só para legado.
  fulfillmentDeadlineAt DateTime? @map("fulfillment_deadline_at")

  /// Observação livre do pedido — nasce com o Épico balcão (`counterOrderSchema.notes`),
  /// mas é campo do PEDIDO, não só do balcão: qualquer fluxo futuro pode
  /// preencher. Nullable, sem tamanho na migration além do já validado no
  /// zod (`.max(500)`).
  notes String? @map("notes")

  /// Snapshot auditável do aceite legal do checkout. Nullable só por legado:
  /// pedidos antigos nasceram antes desta exigência. Novo pedido de
  /// storefront sempre informa as duas versões e o instante do aceite.
  legalTermsVersion   String?   @map("legal_terms_version")
  legalPrivacyVersion String?   @map("legal_privacy_version")
  legalAcceptedAt     DateTime? @map("legal_accepted_at")

  canceledAt     DateTime? @map("canceled_at")
  /// Só o motivo, pra exibição (tela de acompanhamento, WhatsApp). Ator e
  /// papel de quem cancelou vivem no audit_log/order_status_history —
  /// não duplicados aqui.
  canceledReason String?   @map("canceled_reason")

  /// Chave de idempotência da CRIAÇÃO do pedido (Épico balcão) — nula pro
  /// checkout normal (que já tem seu próprio cap de escrita pública, ver
  /// CheckoutOrderRateLimitMiddleware). POS/balcão manda o mesmo header
  /// `Idempotency-Key` em todo retry de rede; a segunda tentativa acha a
  /// linha pelo `@@unique` abaixo e devolve o MESMO pedido, nunca duplica.
  /// Nullable + `@@unique` comum (não parcial): Postgres nunca considera
  /// dois NULL iguais num índice único, então isto já se comporta como
  /// "único só entre valores não-nulos" sem precisar de índice parcial
  /// (diferente do caso de soft-delete, que precisa de WHERE — aqui o nulo
  /// É o estado normal da maioria das linhas, não uma linha "apagada").
  idempotencyKey String? @map("idempotency_key")

  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store           Store                @relation(fields: [storeId], references: [id])
  customer        Customer             @relation(fields: [customerId], references: [id])
  deliveryAddress Address?             @relation(fields: [deliveryAddressId], references: [id])
  coupon          Coupon?              @relation(fields: [couponId], references: [id])
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  adjustments     OrderAdjustment[]
  printJobs       PrintJob[]

  // FKs compostas (store_id/customer_id/delivery_address_id, tenant_id) →
  // stores/customers/addresses(id, tenant_id) na migration.
  @@index([tenantId, customerId])
  // Query quente do gestor de pedidos (Épico 9): pedidos ativos da loja,
  // por status, já ordenados por criação — sem sort adicional.
  @@index([tenantId, storeId, status, createdAt])
  @@index([tenantId, createdAt])
  @@unique([tenantId, idempotencyKey])
  @@map("orders")
}

/// Tipo do desconto do cupom — v1 ENXUTO (Épico conversão, C2):
/// docs/handoff-features-conversao-gestor.md A2. Fora do v1: limite por
/// cliente, janela de horário, primeira-compra (exigem identificar cliente
/// de forma confiável no checkout anônimo — não vale a complexidade agora).
enum CouponDiscountType {
  percent
  fixed
}

/// `discountPercent` XOR `discountValueCents` (CHECK na migration, mesmo
/// padrão do city/polygon de DeliveryZone) — qual dos dois é obrigatório
/// depende de `discountType`.
model Coupon {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  /// Único por tenant, case-insensitive — índice único parcial em
  /// `upper(code)` na migration (CLAUDE.md: nunca no schema.prisma).
  code         String
  discountType CouponDiscountType @map("discount_type")
  /// 1–100, só quando discountType = percent.
  discountPercent Int? @map("discount_percent")
  /// Sempre > 0, só quando discountType = fixed.
  discountValueCents Int? @map("discount_value_cents")
  minOrderCents      Int  @default(0) @map("min_order_cents")
  startsAt           DateTime @map("starts_at")
  endsAt             DateTime @map("ends_at")
  /// Contador GLOBAL do cupom (não por cliente — fora do v1). Incremento é
  /// `UPDATE ... WHERE uses_count < max_uses` + checar linhas afetadas —
  /// mesmo padrão do optimistic lock de zona (P1.2) — pra fechar a corrida
  /// no último uso disponível.
  maxUses   Int @map("max_uses")
  usesCount Int @default(0) @map("uses_count")
  active    Boolean @default(true)
  version   Int @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([tenantId, code])
  @@map("coupons")
}

/// Append-only — mesmo tratamento de audit_log: sem version/deletedAt,
/// item de pedido não se edita depois de criado, só existe.
model OrderItem {
  id        String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String @map("tenant_id") @db.Uuid
  orderId   String @map("order_id") @db.Uuid
  /// Produto nunca é hard-deletado (só soft delete) — FK sempre válida.
  productId String @map("product_id") @db.Uuid

  /// Snapshot — mesmo princípio de CartItem.name.
  name               String
  unitBasePriceCents Int     @map("unit_base_price_cents")
  quantity           Int
  /// Mesmo teto de CartItem.notes.
  notes              String?
  /// (unitBasePriceCents + soma dos deltas dos modificadores) × quantity —
  /// CALCULADO E CONGELADO na criação. Nunca recalcula depois, mesmo que o
  /// preço do produto mude no catálogo.
  lineTotalCents     Int     @map("line_total_cents")

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       Order               @relation(fields: [orderId], references: [id])
  product     Product             @relation(fields: [productId], references: [id])
  modifiers   OrderItemModifier[]
  adjustments OrderAdjustment[]

  // FKs compostas (order_id, tenant_id) → orders(id, tenant_id) e
  // (product_id, tenant_id) → products(id, tenant_id) na migration.
  @@index([tenantId, orderId])
  @@map("order_items")
}

/// Append-only, mesmo tratamento de OrderItem.
model OrderItemModifier {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  orderItemId String @map("order_item_id") @db.Uuid
  /// Modifier nunca é hard-deletado — FK sempre válida.
  modifierId  String @map("modifier_id") @db.Uuid

  /// Snapshot.
  name            String
  priceDeltaCents Int    @map("price_delta_cents")

  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  modifier  Modifier  @relation(fields: [modifierId], references: [id])

  // FKs compostas (order_item_id, tenant_id) → order_items(id, tenant_id) e
  // (modifier_id, tenant_id) → modifiers(id, tenant_id) na migration —
  // modifiers ganha índice único (id, tenant_id) novo, nunca precisou até agora.
  @@index([tenantId, orderItemId])
  @@map("order_item_modifiers")
}

/// Projeção rápida e específica de domínio da transição de status — NÃO
/// substitui audit_log (regra 15, CLAUDE.md): audit_log é o rastro
/// genérico de compliance da plataforma inteira (dinheiro, permissão,
/// módulo), mas seu model não tem `entityId` — reconstruir "linha do tempo
/// do pedido X" a partir dele exigiria vasculhar JSON sem índice, misturado
/// com toda ação sensível do tenant. Esta tabela é só pra ESSA consulta
/// (Épico 9, e disputa futura), indexada por order_id.
model OrderStatusHistory {
  id       String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  orderId  String @map("order_id") @db.Uuid

  /// Nulo só na primeira linha (criação do pedido, sem "de onde veio").
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")

  /// Ator STAFF (dono/gerente/operador) — nulo quando quem transicionou não
  /// foi um funcionário: sistema (auto_canceled/expired, mortos até o
  /// Épico 8) OU o próprio CLIENTE (criação do pedido via checkout;
  /// cancelamento livre antes do aceite, docs/02 §5.2). NUNCA os dois
  /// (actorId e customerId) preenchidos ao mesmo tempo — são semânticas de
  /// identidade diferentes (CLAUDE.md regra 3), nunca misturadas mesmo
  /// aqui.
  actorId    String? @map("actor_id") @db.Uuid
  actorRole  String? @map("actor_role")
  /// Preenchido quando quem transicionou foi o CLIENTE (criação do pedido,
  /// ou cancelamento livre antes do aceite) — nunca junto com actorId.
  /// Corrigido nesta mesma sessão, antes de qualquer linha real existir:
  /// a versão original só previa ator staff, mas a CRIAÇÃO do pedido em si
  /// já é uma transição iniciada pelo cliente, não por ninguém da equipe.
  customerId String? @map("customer_id") @db.Uuid
  /// Obrigatório na APLICAÇÃO pra certas transições (loja cancela sempre
  /// com motivo, docs/02 §5.2) — não é CHECK de banco porque nem toda
  /// transição precisa (received→preparing não precisa de motivo).
  reason     String?

  /// Chave de idempotência da fila offline (Épico 9): gerada no cliente por
  /// intent enfileirado, a MESMA em todo retry. Um retry cuja resposta se
  /// perdeu na volta carrega esta chave → o INSERT desta linha colide no
  /// índice único parcial (order_id, idempotency_key) e o service devolve
  /// "já aplicado" (204) em vez de 409 fantasma. Nulo pra transições que não
  /// vêm da fila (ação online direta). Índice único parcial é SQL à mão na
  /// migration (WHERE idempotency_key IS NOT NULL — nunca do schema.prisma).
  idempotencyKey String? @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id])
  actor    User?     @relation(fields: [actorId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  // FK composta (order_id, tenant_id) → orders(id, tenant_id) na migration.
  // actor_id → users(id) é FK SIMPLES (users não tem tenant_id, mesma
  // exceção documentada em CLAUDE.md pra user_roles). customer_id →
  // customers(id) TAMBÉM é FK simples aqui, de propósito — diferente do
  // padrão de orders.customer_id (que é composta): esta referência não é
  // uma fronteira de posse tenant-scoped que precise do guardrail (o
  // tenant_id da própria linha já garante isolamento via RLS), é só
  // atribuição de autoria.
  @@index([tenantId, orderId, createdAt])
  @@map("order_status_history")
}

/// Épico balcão (edição de pedido) — as 3 operações que o gestor aceita
/// sobre um pedido já criado. `change_qty` cobre tanto aumento quanto
/// redução (o sinal de `quantityDelta` distingue).
enum OrderAdjustmentKind {
  add_item
  remove_item
  change_qty
}

/// Append-only — mesmo tratamento de OrderStatusHistory/audit_log: um
/// ajuste nunca é editado nem apagado, só existe. Uma linha por chamada de
/// `POST .../orders/:orderId/adjustments` (união discriminada por `kind`,
/// não lote). `orderItemId` aponta pra QUAL item o ajuste afetou — pra
/// `add_item`, é o item recém-criado (a linha de OrderItem nasce primeiro,
/// o ajuste referencia ela); pra `remove_item`/`change_qty`, o item já
/// existente. Sempre NOT NULL: as três operações têm um item-alvo, nenhuma
/// mexe no pedido como um todo sem passar por um item.
///
/// `quantityDelta`/`subtotalDeltaCents` são os deltas SIGNED desta operação
/// — `add_item` positivo, `remove_item` negativo (remoção é sempre
/// integral, delta = -quantity original do item), `change_qty` positivo ou
/// negativo (newQuantity - quantidade anterior). `Order.currentSubtotalCents`
/// é `subtotalCents original + Σ` destes deltas — a soma é a fonte da
/// verdade, este delta é o que cada linha CONTRIBUI pra ela, não um valor
/// absoluto.
model OrderAdjustment {
  id          String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  orderId     String              @map("order_id") @db.Uuid
  orderItemId String              @map("order_item_id") @db.Uuid
  kind        OrderAdjustmentKind

  quantityDelta      Int @map("quantity_delta")
  subtotalDeltaCents Int @map("subtotal_delta_cents")

  /// Sempre staff — este endpoint é staff-only (JwtAuthGuard), nunca cliente
  /// nem sistema, então nunca nulo (diferente de OrderStatusHistory.actorId).
  actorId   String @map("actor_id") @db.Uuid
  actorRole String @map("actor_role")

  /// Escrita idempotente (mesma infra do walk-in, Épico balcão) — retry de
  /// rede com a MESMA chave não duplica o ajuste.
  idempotencyKey String @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  actor     User      @relation(fields: [actorId], references: [id])

  // FKs compostas (order_id, tenant_id) → orders(id, tenant_id) e
  // (order_item_id, tenant_id) → order_items(id, tenant_id) na migration —
  // mesmo guardrail de tenant_id de PrintJob/OrderStatusHistory. actor_id →
  // users(id) é FK SIMPLES (users não tem tenant_id, mesma exceção do
  // CLAUDE.md).
  @@index([tenantId, orderId])
  // Idempotência escopada ao PEDIDO (não ao tenant inteiro, diferente de
  // orders.idempotencyKey): a mesma chave em pedidos DIFERENTES não deve
  // colidir — cada ajuste de balcão é uma ação sobre UM pedido específico.
  @@unique([tenantId, orderId, idempotencyKey])
  @@map("order_adjustments")
}

/// Épico 10 (impressão ESC/POS) — módulo consumidor em apps/api/src/printing/.
enum PrintJobStatus {
  queued
  printing
  printed
  failed
}

/// Fila de impressão de comanda (Épico 10). O worker (fora deste pacote)
/// reivindica um job com `SELECT ... FOR UPDATE SKIP LOCKED` (resolve QUEM
/// pega o job — corrida de claim), e conclui com optimistic lock
/// (`WHERE id = ? AND version = ? AND status = 'printing' AND leased_by = ?`
/// — resolve um worker ZUMBI escrevendo depois que outro já reivindicou o
/// mesmo job por lease expirado). As duas travas não são redundantes: cada
/// uma fecha uma corrida diferente.
model PrintJob {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  /// Par com tenant_id no UNIQUE — reenvio do módulo consumidor (retry de
  /// rede, reconexão do agente) não duplica o job.
  idempotencyKey String         @map("idempotency_key")
  status         PrintJobStatus @default(queued)
  /// Conteúdo já renderizado (snapshot) — o job nunca recalcula nada do
  /// pedido depois de criado, mesmo princípio de OrderItem.name.
  ticketText     String         @map("ticket_text")
  /// Largura da impressora em mm (58/80mm, docs/02 §6).
  width          Int
  /// Sem @default: decisão explícita de quem cria o job, nunca "cai" em
  /// cortar (ou não) o papel por omissão.
  cut            Boolean
  attempts       Int            @default(0)
  /// `NULL` = não leaseado. Setado/limpo junto com `leasedBy` — os dois
  /// vivem e morrem juntos no ciclo de claim/release do worker.
  leaseUntil     DateTime?      @map("lease_until")
  /// Id do worker (opaco pro schema — só o módulo consumidor sabe o que é).
  /// Usado no WHERE do update de conclusão pra barrar worker zumbi
  /// pós-lease-expirado escrevendo por cima de quem reivindicou depois.
  leasedBy       String?        @map("leased_by")
  lastError      String?        @map("last_error")
  /// Optimistic lock — ver comentário do model. `WHERE version = :esperado`
  /// no update; 0 linhas = perdeu a corrida (mesma convenção do CLAUDE.md).
  version        Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  printedAt      DateTime?      @map("printed_at")
  deletedAt      DateTime?      @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id])

  // FK composta (order_id, tenant_id) → orders(id, tenant_id) na migration —
  // mesmo guardrail de order_items: impede job apontar pra pedido de OUTRO
  // tenant mesmo com bug de aplicação.
  @@unique([tenantId, idempotencyKey])
  // Índice parcial FIFO dos pendentes vive só na migration (SQL à mão,
  // Prisma não expressa índice parcial) — ver CLAUDE.md § convenções de
  // schema.
  @@index([tenantId, orderId])
  @@map("print_jobs")
}

// ─── Auditoria ────────────────────────────────────────────────────────────────

/// Toda ação sensível (dinheiro, permissão, módulo) grava aqui. Append-only:
/// sem policy de UPDATE/DELETE na migration — o Postgres nega os dois por
/// padrão. tenant_id nullable = ação de plataforma sem tenant associado.
model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  actorRole  String   @map("actor_role")
  action     String
  entity     String
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ip         String?  @db.Inet
  at         DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  actor  User    @relation(fields: [actorId], references: [id])

  @@index([tenantId, at])
  @@map("audit_log")
}
