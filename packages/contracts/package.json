{
  "name": "@molho/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Contratos do Molho: schemas zod, registry de módulos, permissões e microcopy.",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./copy": {
      "types": "./dist/copy.pt-BR.d.ts",
      "default": "./dist/copy.pt-BR.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
