{
  "name": "@molho/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do Molho (NestJS).",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
