{
  "name": "@molho/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do Molho (NestJS).",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "dotenv -e ../../.env.local -- vitest run --passWithNoTests --exclude '**/*.e2e.test.ts'",
    "test:e2e": "dotenv -e ../../.env.local -v REDIS_URL=redis://localhost:6379 -- vitest run --no-file-parallelism '.e2e.test.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@molho/contracts": "workspace:*",
    "@molho/db": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@sentry/nestjs": "^10.71.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.1.28",
    "@prisma/adapter-pg": "^7.8.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "^11.0.0",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
