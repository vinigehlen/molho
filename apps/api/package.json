    "@nestjs/platform-express": "^11.1.28",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "dotenv-cli": "^11.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
